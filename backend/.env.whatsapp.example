# ═════════════════════════════════════════════════════════════════
# CONFIGURAÇÃO DO WHATSAPP COM REVOLUTION API
# ═════════════════════════════════════════════════════════════════

# Habilitar/Desabilitar WhatsApp (true/false)
# Se false, o sistema funcionará normalmente sem enviar mensagens
WHATSAPP_ENABLED=true

# URL da API Revolution/Evolution
# Exemplos:
#   - Local (Docker): http://localhost:3000/api/messages/send
#   - Cloud: https://seu-servidor.com/api/messages/send
WHATSAPP_API_URL=http://localhost:3000/api/messages/send

# Token/Chave de autenticação da API Revolution
# Obter este valor do painel de administração da Evolution API
WHATSAPP_API_KEY=seu_token_api_aqui

# ═════════════════════════════════════════════════════════════════
# IMPORTANTE: Requisitos para funcionamento
# ═════════════════════════════════════════════════════════════════
#
# 1. Cada ONG deve ter um telefone preenchido:
#    Ong.Telefone = "55XXXXXXXXXX" (código país + DDD + número)
#
# 2. O formulário de adoção deve ter um campo "Telefone" obrigatório:
#    - Nome do campo: "Telefone" ou "telefone"
#    - Obrigatório: true
#    - Tipo: TipoCampoTelefone ou TipoCampoTexto
#
# 3. Ao preencher o formulário, os usuários devem fornecer:
#    - Nome (obrigatório, buscado nas respostas)
#    - Email (obrigatório para confirmação)
#    - Telefone (obrigatório para WhatsApp)
#
# ═════════════════════════════════════════════════════════════════

# Exemplo de como iniciar Revolution API com Docker
# docker pull atendai/evolution-api:latest
# docker run -p 3000:3000 atendai/evolution-api:latest
