                    }
                },
                "updated_at": {
                    "type": "string"
                }
            }
        },
        "models.Pet": {
            "type": "object",
            "properties": {
                "created_at": {
                    "type": "string"
                },
                "especie": {
                    "type": "string"
                },
                "id": {
                    "type": "integer"
                },
                "idade": {
                    "type": "integer"
                },
                "nome": {
                    "type": "string"
                },
                "ong_id": {
                    "type": "integer"
                },
                "raca": {
