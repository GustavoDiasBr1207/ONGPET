                },
                "email": {
                    "type": "string"
                },
                "endereco": {
                    "type": "string"
                },
                "id": {
                    "type": "integer"
                },
                "nome": {
                    "type": "string"
                },
                "pedidosAdocao": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/models.PedidoAdocao"
                    }
                },
                "telefone": {
                    "type": "string"
                },
                "updated_at": {
                    "type": "string"
                }
            }
        },
        "models.PedidoAdocao": {
            "type": "object",
